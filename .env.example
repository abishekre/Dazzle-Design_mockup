# Copy to .env.local and fill in. The app runs without these (quote form logs
# to the server console); adding them turns on real persistence + notifications.

# --- Supabase (persist quote requests) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the browser

# --- Resend (email the team on a new quote) ---
# https://resend.com/api-keys  — the "from" domain must be verified in Resend
RESEND_API_KEY=
QUOTE_NOTIFY_FROM=Dazzle Design <hello@yourdomain.com>
QUOTE_NOTIFY_TO=founder1@example.com,founder2@example.com

# --- Optional: instant team ping (Discord or Slack incoming webhook) ---
TEAM_WEBHOOK_URL=
